/* RotiKita UI/UX v2 alignment — page components */
.rk-page-heading-v2 { align-items: center; margin-bottom: 18px; }
.rk-heading-actions { display:flex; align-items:center; justify-content:flex-end; flex-wrap:wrap; gap:10px; }
.rk-preview-notice { display:flex; align-items:center; gap:10px; padding:10px 13px; margin:0 0 18px; color:#776454; background:#fbf0df; border:1px solid #efdfc6; border-radius:11px; font-size:11px; line-height:1.55; }
.rk-preview-notice span { flex:0 0 auto; padding:4px 7px; color:#87542f; background:#f4dfc1; border-radius:6px; font-size:9px; font-weight:900; letter-spacing:.08em; }
.rk-welcome-v2 { min-height:190px; margin-bottom:18px; }
.rk-welcome-actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:18px; }
.rk-bakery-stamp { display:flex; flex-direction:column; align-items:center; justify-content:center; width:150px; height:150px; flex:0 0 150px; border:1px solid rgba(139,91,59,.2); border-radius:50%; color:#9b6748; background:rgba(255,250,243,.42); transform:rotate(7deg); }
.rk-bakery-stamp span,.rk-bakery-stamp small { font-size:9px; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }
.rk-bakery-stamp strong { font-family:Georgia,serif; font-size:70px; line-height:1; letter-spacing:-.08em; }
.rk-bakery-stamp small { font-size:7px; }
.rk-stats-four { grid-template-columns:repeat(4,minmax(0,1fr)); }
.rk-stats-three { grid-template-columns:repeat(3,minmax(0,1fr)); }
.rk-stat-v2 { display:block; padding:17px 18px; }
.rk-stat-top { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:13px; }
.rk-stat-top .rk-stat-icon { margin:0; }
.rk-stat-change { display:inline-flex; align-items:center; padding:4px 7px; color:#6e7654; background:#edf1e5; border-radius:999px; font-size:9px; font-weight:850; white-space:nowrap; }
.rk-stat-change.positive { color:#28734f; background:#e9f5ec; }
.rk-stat-change.warning { color:#98652f; background:#fbefdd; }
.rk-stat-value-money { font-size:22px; }
.rk-dashboard-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr); gap:18px; }
.rk-panel-v2 { padding:22px; }
.rk-filter-chip { padding:7px 10px; color:#77685d; background:#fbf7f1; border:1px solid var(--rk-line); border-radius:9px; font-size:10px; font-weight:750; white-space:nowrap; }
.rk-chart-summary { display:flex; align-items:baseline; flex-wrap:wrap; gap:12px; margin:4px 0 14px; }
.rk-chart-summary>strong { font-size:26px; letter-spacing:-.055em; }
.rk-inline-positive { color:#28734f; font-size:11px; font-weight:850; }
.rk-inline-positive small { color:var(--rk-muted); font-size:10px; font-weight:500; }
.rk-bar-chart { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); align-items:end; gap:14px; min-height:172px; padding:13px 6px 0; border-bottom:1px solid var(--rk-line); background:repeating-linear-gradient(to bottom,transparent 0,transparent 41px,#f2ebe3 42px,#f2ebe3 43px); }
.rk-bar-col { display:flex; flex-direction:column; align-items:center; justify-content:end; height:100%; gap:9px; }
.rk-bar-track { display:flex; align-items:end; justify-content:center; width:100%; height:140px; }
.rk-bar-track span { display:block; width:min(28px,70%); min-height:8px; background:linear-gradient(180deg,#d99774,#c86d4d); border-radius:7px 7px 2px 2px; box-shadow:0 4px 9px rgba(168,80,51,.1); }
.rk-bar-col:nth-child(6) .rk-bar-track span { background:linear-gradient(180deg,#b96a4c,#9f4d34); }
.rk-bar-col small { padding-bottom:10px; color:var(--rk-muted); font-size:10px; }
.rk-chart-legend { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:12px; color:var(--rk-muted); font-size:10px; }
.rk-chart-legend span:first-child { display:flex; align-items:center; gap:7px; }
.rk-chart-legend i { display:inline-block; width:8px; height:8px; border-radius:3px; background:var(--rk-terracotta); }
.rk-priority-row { display:flex; align-items:center; gap:11px; padding:14px 0; color:var(--rk-espresso); border-bottom:1px solid #f1e9e1; }
.rk-priority-row:last-of-type { border-bottom:0; }
.rk-priority-row:hover { color:var(--rk-terracotta-dark); text-decoration:none; }
.rk-priority-icon { display:grid; width:37px; height:37px; flex:0 0 37px; place-items:center; border-radius:11px; font-size:14px; }
.priority-orange { color:#9a6032; background:#fbefdd; }
.priority-red { color:#a64f3c; background:#fff0ed; }
.priority-green { color:#28734f; background:#e9f5ec; }
.rk-priority-copy { display:flex; flex:1; min-width:0; flex-direction:column; gap:3px; }
.rk-priority-copy strong { color:var(--rk-espresso); font-size:11px; }
.rk-priority-copy small { color:var(--rk-muted); font-size:10px; line-height:1.5; }
.rk-priority-row>b { color:var(--rk-espresso); font-size:13px; white-space:nowrap; }
.rk-priority-row>b span { margin-left:4px; color:var(--rk-terracotta); }
.rk-priority-foot,.rk-helper-note { color:var(--rk-muted-2); font-size:10px; line-height:1.6; }
.rk-mt-18 { margin-top:18px; }
.rk-toolbar { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin:0 0 17px; }
.rk-toolbar-top { justify-content:space-between; }
.rk-search { display:flex; align-items:center; gap:9px; flex:1 1 260px; min-width:180px; min-height:42px; padding:0 12px; color:var(--rk-muted); background:#fffdfa; border:1px solid var(--rk-line); border-radius:10px; }
.rk-search>span { font-size:17px; line-height:1; }
.rk-search input { width:100%; min-width:0; padding:10px 0; color:var(--rk-espresso); background:transparent; border:0; outline:0; font-size:11px; }
.rk-search input:focus { box-shadow:none; }
.rk-select { min-height:42px; max-width:100%; padding:0 31px 0 12px; color:var(--rk-espresso-2); background:#fffdfa; border:1px solid var(--rk-line); border-radius:10px; font-size:11px; }
.rk-data-table { min-width:760px; }
.rk-data-table th { white-space:nowrap; }
.rk-data-table td { vertical-align:middle; }
.rk-cell-sub { display:block; margin-top:3px; color:var(--rk-muted-2); font-size:10px; line-height:1.45; }
.rk-muted-cell { color:var(--rk-muted); }
.rk-person-cell,.rk-product-cell { display:flex; align-items:center; gap:10px; min-width:165px; }
.rk-person-cell>span:last-child,.rk-product-cell>span:last-child { display:flex; min-width:0; flex-direction:column; gap:3px; }
.rk-person-cell strong,.rk-product-cell strong { font-size:11px; }
.rk-person-cell small,.rk-product-cell small { color:var(--rk-muted); font-size:10px; }
.rk-avatar-initial { display:grid; width:36px; height:36px; flex:0 0 36px; place-items:center; color:#8e5238; background:#f4e3d4; border:1px solid #ead2c0; border-radius:50%; font-size:10px; font-weight:900; }
.rk-tone-0 { color:#8b5037; background:#f4e3d4; }
.rk-tone-1 { color:#416b53; background:#e6efe4; border-color:#d4e5d1; }
.rk-tone-2 { color:#74558c; background:#f0e6f6; border-color:#e3d5eb; }
.rk-tone-3 { color:#9b6839; background:#fbefd8; border-color:#eedfbe; }
.rk-mono { color:#8b6c58; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:10px; }
.rk-badge { display:inline-flex; align-items:center; width:max-content; max-width:100%; padding:5px 8px; color:#77685d; background:#f4eee7; border-radius:999px; font-size:9px; font-weight:850; line-height:1.25; white-space:nowrap; }
.rk-badge-active,.rk-badge-completed,.rk-badge-resolved { color:#28734f; background:#e9f5ec; }
.rk-badge-new,.rk-badge-pending { color:#97632e; background:#fbefdd; }
.rk-badge-processing,.rk-badge-ready { color:#956040; background:#f8e8de; }
.rk-badge-cancelled,.rk-badge-out { color:#a43e31; background:#fff0ed; }
.rk-badge-low { color:#94642e; background:#fbefdd; }
.rk-table-action { padding:5px 7px; color:var(--rk-terracotta-dark); background:transparent; border:0; border-radius:7px; font-size:10px; font-weight:850; cursor:pointer; white-space:nowrap; }
.rk-table-action:hover { background:var(--rk-terracotta-soft); }
.rk-icon-button { display:inline-grid; min-width:30px; min-height:30px; place-items:center; color:var(--rk-muted); background:#fffdfa; border:1px solid var(--rk-line); border-radius:8px; cursor:pointer; }
.rk-icon-button:hover { color:var(--rk-terracotta-dark); background:#fff5ee; }
.rk-table-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding-top:15px; color:var(--rk-muted); font-size:10px; }
.rk-pagination { display:flex; align-items:center; gap:4px; }
.rk-pagination button { min-width:29px; height:29px; padding:0 7px; color:var(--rk-muted); background:transparent; border:1px solid transparent; border-radius:8px; font-size:10px; cursor:pointer; }
.rk-pagination button.is-current { color:white; background:var(--rk-terracotta); }
.rk-pagination button:disabled { opacity:.35; cursor:not-allowed; }
.rk-product-thumb { display:grid; width:42px; height:42px; flex:0 0 42px; place-items:center; border-radius:12px; font-size:23px; }
.rk-art-peach { background:linear-gradient(145deg,#fae7d6,#f1d4bc); }
.rk-art-gold { background:linear-gradient(145deg,#fbf0d6,#f1ddb0); }
.rk-art-sage { background:linear-gradient(145deg,#e6eddd,#cbdcc4); }
.rk-art-rose { background:linear-gradient(145deg,#fae3df,#edc5bd); }
.rk-orders-layout { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(245px,.72fr); gap:18px; align-items:start; }
.rk-order-detail { padding:18px; background:#fffaf5; border:1px solid var(--rk-line); border-radius:15px; }
.rk-order-detail-head,.rk-feedback-detail-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
.rk-order-detail-head h2,.rk-feedback-detail-top h2 { margin:4px 0 0; font-size:19px; letter-spacing:-.04em; }
.rk-detail-person { display:flex; align-items:center; gap:10px; padding:17px 0; margin-top:12px; border-bottom:1px solid var(--rk-line); }
.rk-detail-person>div { display:flex; min-width:0; flex-direction:column; gap:3px; }
.rk-detail-person strong { font-size:11px; }
.rk-detail-person small { color:var(--rk-muted); font-size:10px; overflow-wrap:anywhere; }
.rk-detail-section { padding:15px 0; border-bottom:1px solid var(--rk-line); }
.rk-detail-label { color:var(--rk-muted); font-size:10px; font-weight:750; }
.rk-detail-section p { margin:7px 0 0; font-size:11px; line-height:1.7; }
.rk-detail-total { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px; padding:15px 0 7px; }
.rk-detail-total span { color:var(--rk-muted); font-size:10px; }
.rk-detail-total strong { font-size:17px; letter-spacing:-.035em; }
.rk-detail-total small { flex-basis:100%; text-align:right; color:var(--rk-muted); font-size:10px; }
.rk-detail-status-field { margin:11px 0; }
.rk-detail-status-field span,.rk-field>span { display:block; margin-bottom:6px; color:var(--rk-espresso-2); font-size:11px; font-weight:750; }
.rk-detail-note { margin:10px 0 0; color:var(--rk-muted-2); font-size:9px; line-height:1.5; }
.rk-promo-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:15px; }
.rk-promo-card { display:flex; gap:14px; padding:17px; background:#fffdf9; border:1px solid var(--rk-line); border-radius:15px; }
.rk-promo-ticket { position:relative; display:flex; width:82px; min-width:82px; min-height:105px; flex-direction:column; align-items:center; justify-content:center; border-radius:12px; }
.rk-promo-ticket::before,.rk-promo-ticket::after { position:absolute; left:0; right:0; height:10px; content:""; background:var(--rk-paper); border-radius:50%; }
.rk-promo-ticket::before { top:-5px; }.rk-promo-ticket::after { bottom:-5px; }
.rk-promo-ticket strong { font-size:21px; letter-spacing:-.07em; }.rk-promo-ticket small { font-size:8px; font-weight:900; letter-spacing:.18em; }
.rk-promo-content { flex:1; min-width:0; }
.rk-promo-top { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px; }
.rk-promo-type { color:var(--rk-muted); font-size:9px; }
.rk-promo-content h3 { margin:9px 0 4px; font-size:13px; letter-spacing:-.02em; }
.rk-promo-content p { margin:0; color:var(--rk-muted); font-size:10px; line-height:1.6; }
.rk-promo-code { display:flex; align-items:center; gap:8px; padding:8px 9px; margin-top:11px; background:#fbf5ee; border:1px dashed #e0cbb9; border-radius:8px; }
.rk-promo-code span { color:var(--rk-muted); font-size:8px; font-weight:850; letter-spacing:.07em; }
.rk-promo-code strong { flex:1; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:10px; letter-spacing:.08em; }
.rk-promo-meta { display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px; margin-top:10px; color:var(--rk-muted); font-size:9px; }
.rk-promo-progress { height:5px; margin-top:7px; overflow:hidden; background:#f0e7de; border-radius:99px; }
.rk-promo-progress span { display:block; height:100%; background:var(--rk-terracotta); border-radius:inherit; }
.rk-info-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.rk-info-card { display:flex; align-items:flex-start; gap:10px; padding:14px; background:#fffaf5; border:1px solid var(--rk-line); border-radius:12px; }
.rk-info-card .rk-quick-icon { flex:0 0 35px; margin:0; }
.rk-info-card strong { font-size:11px; }.rk-info-card p { margin:5px 0 0; color:var(--rk-muted); font-size:10px; line-height:1.6; }
.rk-feedback-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,.94fr); gap:16px; align-items:start; }
.rk-feedback-list { display:grid; gap:7px; }
.rk-feedback-row { display:flex; align-items:flex-start; width:100%; gap:10px; padding:13px; color:var(--rk-espresso); text-align:left; background:#fffdfa; border:1px solid var(--rk-line); border-radius:12px; cursor:pointer; }
.rk-feedback-row:hover { border-color:#dfb7a6; }.rk-feedback-row.is-selected { background:#fff7f0; border-color:#d8a68e; box-shadow:inset 3px 0 0 var(--rk-terracotta); }
.rk-feedback-row-copy { display:flex; min-width:0; flex:1; flex-direction:column; gap:5px; }
.rk-feedback-row-top { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px; }.rk-feedback-row-top strong { font-size:11px; }
.rk-feedback-row-copy>small { color:var(--rk-muted); font-size:9px; }.rk-feedback-row-copy>span:not(.rk-feedback-row-top) { color:#69594e; font-size:10px; line-height:1.55; }
.rk-feedback-detail { padding:18px; background:#fffaf5; border:1px solid var(--rk-line); border-radius:15px; }
.rk-feedback-meta-row { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:13px; color:var(--rk-muted); font-size:10px; }
.rk-stars { color:#d79541; letter-spacing:.12em; font-size:14px; white-space:nowrap; }
.rk-feedback-quote { padding:13px; margin:12px 0 0; color:#655348; background:#fbf0e6; border:1px solid #f0dfcf; border-radius:10px; font-size:11px; line-height:1.75; }
.rk-feedback-reply { margin-top:15px; }.rk-feedback-reply .rk-field { margin-bottom:11px; }
.rk-modal { position:fixed; z-index:100; inset:0; display:none; align-items:center; justify-content:center; padding:20px; }.rk-modal[aria-hidden="false"] { display:flex; }
.rk-modal-backdrop { position:absolute; inset:0; background:rgba(38,27,21,.55); backdrop-filter:blur(4px); }
.rk-modal-card { position:relative; z-index:1; width:min(620px,100%); max-height:min(88vh,850px); padding:23px; overflow:auto; background:var(--rk-paper); border:1px solid var(--rk-line); border-radius:18px; box-shadow:0 28px 90px rgba(30,20,14,.25); }
.rk-modal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding-bottom:17px; margin-bottom:18px; border-bottom:1px solid var(--rk-line); }.rk-modal-head h2 { margin:5px 0; font-size:22px; letter-spacing:-.045em; }.rk-modal-head p:last-child { margin:0; color:var(--rk-muted); font-size:11px; }
.rk-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:13px; }.rk-field { display:block; min-width:0; margin:0; }.rk-field input,.rk-field select,.rk-field textarea { width:100%; min-height:42px; padding:10px 11px; color:var(--rk-espresso); background:#fffdfa; border:1px solid var(--rk-line); border-radius:9px; font-size:11px; }.rk-field textarea { min-height:75px; resize:vertical; }
.rk-span-2 { grid-column:span 2; }.rk-modal-actions { display:flex; align-items:center; justify-content:flex-end; flex-wrap:wrap; gap:8px; margin-top:18px; }
.rk-toast { position:fixed; z-index:200; right:22px; bottom:22px; max-width:min(420px,calc(100vw - 32px)); padding:13px 16px; color:#fffaf4; background:#36271f; border:1px solid rgba(255,255,255,.1); border-radius:12px; box-shadow:0 15px 40px rgba(30,20,14,.2); font-size:11px; line-height:1.55; opacity:0; pointer-events:none; transform:translateY(10px); transition:opacity .2s,transform .2s; }.rk-toast.is-visible { opacity:1; transform:translateY(0); }
.rk-quick-grid-v2 .rk-quick-card { position:relative; padding:19px; }.rk-quick-grid-v2 .rk-card-arrow { position:absolute; top:20px; right:18px; color:var(--rk-terracotta); font-size:16px; }.rk-quick-grid-v2 .rk-quick-icon { width:39px; height:39px; }
.rk-customer-welcome { background:linear-gradient(115deg,#f3e1d0 0%,#fff4e7 100%); }
.rk-customer-art { position:relative; display:grid; width:142px; height:142px; place-items:center; flex:0 0 142px; background:#f3decb; border:1px solid #e6c6ad; border-radius:50%; font-size:64px; transform:rotate(-7deg); }
.rk-customer-art span { position:absolute; right:-13px; bottom:2px; padding:8px 11px; color:#fff8ef; background:var(--rk-terracotta); border-radius:10px; font-size:9px; font-weight:900; line-height:1.35; letter-spacing:.08em; text-align:center; text-transform:uppercase; transform:rotate(10deg); }
.rk-section-heading { display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:15px; margin:25px 0 14px; }.rk-section-heading h2 { margin:5px 0 0; font-size:19px; letter-spacing:-.045em; }.rk-section-heading p:not(.rk-eyebrow) { margin:5px 0 0; color:var(--rk-muted); font-size:11px; }
.rk-customer-order-card { display:flex; align-items:center; gap:13px; padding:15px; background:#fffaf5; border:1px solid var(--rk-line); border-radius:13px; }.rk-order-icon { display:grid; width:50px; height:50px; flex:0 0 50px; place-items:center; background:#f5e2d1; border-radius:12px; font-size:25px; }.rk-customer-order-copy { display:flex; min-width:0; flex:1; flex-direction:column; align-items:flex-start; gap:5px; }.rk-customer-order-copy strong { font-size:12px; }.rk-customer-order-copy small,.rk-customer-order-total small { color:var(--rk-muted); font-size:10px; }.rk-customer-order-total { display:flex; flex-direction:column; align-items:flex-end; gap:4px; }.rk-customer-order-total strong { font-size:13px; white-space:nowrap; }
.rk-catalog-hero { position:relative; display:grid; grid-template-columns:1.1fr .9fr; min-height:270px; margin-bottom:26px; overflow:hidden; background:linear-gradient(112deg,#f0decb 0%,#f9ecdd 58%,#f3dfce 100%); border:1px solid #e7d0bc; border-radius:22px; }.rk-catalog-hero-copy { position:relative; z-index:2; padding:clamp(24px,4vw,42px); }.rk-mini-label { display:inline-flex; padding:6px 9px; color:#8d5b40; background:rgba(255,253,249,.6); border:1px solid rgba(158,104,71,.17); border-radius:999px; font-size:8px; font-weight:900; letter-spacing:.12em; }.rk-catalog-hero h2 { margin:17px 0 12px; font-size:clamp(30px,4vw,46px); line-height:1.03; letter-spacing:-.065em; }.rk-catalog-hero h2 em { color:var(--rk-terracotta-dark); font-family:Georgia,serif; font-weight:500; }.rk-catalog-hero p { max-width:450px; margin:0; color:#7b6252; font-size:12px; line-height:1.8; }.rk-catalog-hero .rk-btn { margin-top:17px; }.rk-catalog-hero-copy>small { display:block; margin-top:12px; color:#9b806b; font-size:9px; letter-spacing:.04em; }
.rk-catalog-hero-art { position:relative; display:grid; place-items:center; min-width:0; }.rk-hero-circle { position:absolute; width:min(29vw,250px); aspect-ratio:1; border:1px solid rgba(153,93,56,.18); border-radius:50%; box-shadow:0 0 0 22px rgba(153,93,56,.035),0 0 0 46px rgba(153,93,56,.025); }.rk-hero-bread { position:relative; z-index:1; font-size:clamp(90px,12vw,145px); filter:drop-shadow(0 15px 12px rgba(107,62,32,.15)); transform:rotate(-14deg); }.rk-hero-bread-small { position:absolute; z-index:2; right:16%; bottom:17%; font-size:48px; transform:rotate(17deg); }.rk-hero-sparkle { position:absolute; top:19%; right:24%; color:var(--rk-terracotta); font-size:27px; }
.rk-catalog-section { margin-top:24px; }.rk-catalog-search { flex:0 1 290px; }.rk-category-pills { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 18px; }.rk-category-pills button { padding:8px 13px; color:#79695e; background:#fffdfa; border:1px solid var(--rk-line); border-radius:999px; font-size:10px; font-weight:750; cursor:pointer; }.rk-category-pills button:hover,.rk-category-pills button.is-active { color:white; background:var(--rk-espresso); border-color:var(--rk-espresso); }
.rk-product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }.rk-store-product { min-width:0; overflow:hidden; background:var(--rk-paper); border:1px solid var(--rk-line); border-radius:16px; box-shadow:var(--rk-shadow-sm); transition:transform .18s,box-shadow .18s,border-color .18s; }.rk-store-product:hover { border-color:#dfc4b2; box-shadow:var(--rk-shadow-lg); transform:translateY(-3px); }.rk-store-product-art { position:relative; display:grid; height:145px; place-items:center; overflow:hidden; font-size:67px; }.rk-store-product-art>span:last-of-type { filter:drop-shadow(0 9px 7px rgba(72,43,26,.13)); transition:transform .18s; }.rk-store-product:hover .rk-store-product-art>span:last-of-type { transform:scale(1.06) rotate(-4deg); }.rk-product-tag { position:absolute; z-index:2; top:12px; left:12px; padding:5px 7px; color:#875436; background:rgba(255,253,249,.85); border-radius:6px; font-size:8px; font-weight:900; }.rk-product-heart { position:absolute; z-index:2; top:10px; right:10px; display:grid; width:29px; height:29px; place-items:center; color:#8f6b58; background:rgba(255,253,249,.8); border:1px solid rgba(140,99,75,.13); border-radius:50%; font-size:17px; cursor:pointer; }.rk-store-product-info { padding:15px; }.rk-store-product-info>small { color:var(--rk-terracotta-dark); font-size:9px; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }.rk-store-product-info h3 { margin:6px 0; font-size:14px; letter-spacing:-.025em; }.rk-store-product-info p { min-height:36px; margin:0; color:var(--rk-muted); font-size:10px; line-height:1.65; }.rk-store-product-bottom { display:flex; align-items:center; justify-content:space-between; gap:10px; padding-top:13px; margin-top:12px; border-top:1px solid #f1e8df; }.rk-store-product-bottom>strong { font-size:13px; white-space:nowrap; }.rk-add-cart { display:inline-flex; align-items:center; gap:5px; padding:8px 10px; color:var(--rk-terracotta-dark); background:var(--rk-terracotta-soft); border:1px solid #f0d5c7; border-radius:9px; font-size:10px; font-weight:850; cursor:pointer; }.rk-add-cart:hover { color:white; background:var(--rk-terracotta); border-color:var(--rk-terracotta); }
.rk-catalog-promo { display:flex; align-items:center; gap:14px; padding:18px; margin-top:22px; background:linear-gradient(105deg,#f5e7da,#fff9f1); border:1px solid #ead9c8; border-radius:15px; }.rk-catalog-promo .rk-quick-icon { flex:0 0 38px; margin:0; }.rk-catalog-promo>div { flex:1; }.rk-catalog-promo strong { font-size:12px; }.rk-catalog-promo p { margin:5px 0 0; color:var(--rk-muted); font-size:10px; }.rk-catalog-promo-note { color:#98745d; font-size:9px; }
.rk-status-timeline { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }.rk-status-timeline>div { position:relative; display:flex; flex-direction:column; gap:6px; padding:0 7px; color:var(--rk-muted-2); }.rk-status-timeline>div::after { position:absolute; top:15px; left:34px; right:-13px; height:2px; content:""; background:#e9dfd4; }.rk-status-timeline>div:last-child::after { display:none; }.rk-status-timeline>div>span { z-index:1; display:grid; width:30px; height:30px; place-items:center; color:var(--rk-muted); background:#f1e9df; border-radius:50%; font-size:10px; font-weight:900; }.rk-status-timeline>div.is-done>span { color:white; background:var(--rk-green); }.rk-status-timeline>div.is-current>span { color:white; background:var(--rk-terracotta); box-shadow:0 0 0 4px var(--rk-terracotta-soft); }.rk-status-timeline strong { color:var(--rk-espresso-2); font-size:10px; }.rk-status-timeline small { font-size:9px; line-height:1.5; }
.rk-feedback-customer-grid { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr); gap:18px; align-items:start; }.rk-feedback-aside { display:grid; gap:16px; }.rk-feedback-aside-card { padding:23px; color:#fdf6ee; background:var(--rk-espresso); border-radius:16px; }.rk-aside-icon { display:grid; width:39px; height:39px; place-items:center; color:#f3c5aa; background:rgba(255,255,255,.1); border-radius:12px; font-size:18px; }.rk-feedback-aside-card h2 { margin:14px 0 7px; font-size:19px; letter-spacing:-.04em; }.rk-feedback-aside-card p { margin:0; color:#d7c3b5; font-size:11px; line-height:1.75; }.rk-aside-points { display:grid; gap:9px; margin-top:18px; }.rk-aside-points span { display:flex; align-items:center; gap:8px; color:#f1e4d8; font-size:10px; }.rk-aside-points i { display:grid; width:18px; height:18px; place-items:center; color:#f8d2b7; background:rgba(255,255,255,.1); border-radius:50%; font-size:9px; font-style:normal; }.rk-feedback-status-key { padding:12px 0; border-bottom:1px solid #f1e8df; }.rk-feedback-status-key:last-child { border-bottom:0; }.rk-feedback-status-key p { margin:7px 0 0; color:var(--rk-muted); font-size:10px; line-height:1.6; }
.rk-rating-field { min-width:0; padding:0; margin:0; border:0; }.rk-rating-field legend { margin-bottom:8px; color:var(--rk-espresso-2); font-size:11px; font-weight:750; }.rk-rating-options { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:7px; }.rk-rating-options label { display:flex; align-items:center; flex-direction:column; gap:4px; padding:9px 3px; background:#fffdfa; border:1px solid var(--rk-line); border-radius:9px; cursor:pointer; }.rk-rating-options input { position:absolute; opacity:0; pointer-events:none; }.rk-rating-options span { color:#d39a45; font-size:20px; }.rk-rating-options small { color:var(--rk-muted); font-size:8px; }.rk-rating-options label:has(input:checked) { background:#fbefdd; border-color:#dcb78f; }.rk-rating-options label:has(input:checked) small { color:#855633; font-weight:850; }.rk-form-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:16px; }.rk-form-bottom .rk-helper-note { max-width:360px; margin:0; }.rk-previous-feedback-list { display:grid; }.rk-previous-feedback-list article { display:flex; align-items:flex-start; gap:12px; padding:14px 0; border-bottom:1px solid #f1e8df; }.rk-previous-feedback-list article:last-child { border-bottom:0; }.rk-previous-feedback-list .rk-quick-icon { flex:0 0 35px; margin:0; }.rk-previous-feedback-copy { flex:1; min-width:0; }.rk-previous-feedback-copy>div { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }.rk-previous-feedback-copy strong { font-size:11px; }.rk-previous-feedback-copy small { color:var(--rk-muted-2); font-size:9px; }.rk-previous-feedback-copy p { margin:6px 0 0; color:var(--rk-muted); font-size:10px; line-height:1.6; }

@media (max-width:1200px) { .rk-stats-four { grid-template-columns:repeat(2,minmax(0,1fr)); }.rk-dashboard-grid { grid-template-columns:1fr; }.rk-orders-layout { grid-template-columns:1fr; }.rk-order-detail { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 17px; }.rk-order-detail-head,.rk-detail-person,.rk-detail-section,.rk-detail-total,.rk-detail-status-field,.rk-order-detail>.rk-btn,.rk-detail-note { grid-column:span 2; }.rk-promo-grid { grid-template-columns:1fr; } }
@media (max-width:900px) { .rk-product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.rk-feedback-layout,.rk-feedback-customer-grid { grid-template-columns:1fr; }.rk-info-grid { grid-template-columns:1fr; }.rk-catalog-hero { grid-template-columns:1.1fr .8fr; }.rk-customer-art { width:112px;height:112px;flex-basis:112px;font-size:51px; } }
@media (max-width:650px) { .rk-page-heading-v2 { display:block; }.rk-heading-actions { justify-content:flex-start; margin-top:14px; }.rk-preview-notice { align-items:flex-start; }.rk-stats-four,.rk-stats-three { grid-template-columns:1fr; }.rk-stat-v2 { padding:15px; }.rk-bar-chart { gap:7px; }.rk-chart-summary>strong { font-size:22px; }.rk-panel-v2 { padding:16px; }.rk-toolbar { align-items:stretch; }.rk-search,.rk-select { flex:1 1 100%; width:100%; }.rk-promo-card { flex-direction:column; }.rk-promo-ticket { width:100%; min-height:68px; min-width:0; flex-direction:row; gap:8px; }.rk-promo-ticket::before,.rk-promo-ticket::after { top:calc(50% - 5px); bottom:auto; width:10px; height:10px; }.rk-promo-ticket::before { left:-5px; right:auto; }.rk-promo-ticket::after { left:auto; right:-5px; }.rk-info-grid { grid-template-columns:1fr; }.rk-order-detail { display:block; }.rk-catalog-hero { grid-template-columns:1fr; }.rk-catalog-hero-copy { padding:25px; }.rk-catalog-hero-art { min-height:130px; }.rk-hero-bread { font-size:90px; }.rk-product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }.rk-store-product-art { height:110px; font-size:53px; }.rk-store-product-info { padding:11px; }.rk-store-product-info h3 { font-size:12px; }.rk-store-product-info p { font-size:9px; }.rk-store-product-bottom { align-items:flex-start; flex-direction:column; }.rk-add-cart { width:100%; justify-content:center; }.rk-catalog-promo { align-items:flex-start; flex-wrap:wrap; }.rk-catalog-promo-note { flex-basis:100%; margin-left:52px; }.rk-status-timeline { grid-template-columns:1fr; gap:12px; }.rk-status-timeline>div { display:grid; grid-template-columns:32px minmax(0,1fr); gap:3px 9px; padding:0; }.rk-status-timeline>div::after { top:29px; bottom:-13px; left:14px; right:auto; width:2px; height:auto; }.rk-status-timeline>div>span { grid-row:span 2; }.rk-status-timeline small { grid-column:2; }.rk-form-grid { grid-template-columns:1fr; }.rk-span-2 { grid-column:span 1; }.rk-rating-options { gap:4px; }.rk-rating-options small { font-size:7px; }.rk-customer-order-card { align-items:flex-start; flex-wrap:wrap; }.rk-customer-order-total { margin-left:auto; }.rk-customer-art { display:none; }.rk-feedback-row { padding:10px; }.rk-feedback-detail { padding:14px; }.rk-modal { padding:10px; }.rk-modal-card { padding:17px; }.rk-modal-head h2 { font-size:19px; } }
@media (prefers-reduced-motion:reduce) { .rk-store-product,.rk-store-product-art>span:last-of-type,.rk-toast { transition:none!important; } }
[hidden] { display:none !important; }
body.rk-modal-open { overflow:hidden; }
.rk-data-table tr.is-selected-row td { background:#fff7f0; }
.rk-data-table tr.is-selected-row td:first-child { box-shadow:inset 3px 0 0 var(--rk-terracotta); }
