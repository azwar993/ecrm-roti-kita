<script>
document.addEventListener('DOMContentLoaded', function () {
    const type = document.getElementById('order-type');
    const tableWrap = document.getElementById('table-number-wrap');
    const tableInput = tableWrap ? tableWrap.querySelector('input') : null;
    function syncTableField() {
        const dineIn = type && type.value === 'dine_in';
        if (tableInput) tableInput.required = dineIn;
        if (tableWrap) tableWrap.style.opacity = dineIn ? '1' : '.65';
    }
    if (type) type.addEventListener('change', syncTableField);
    syncTableField();
});
</script>
@endsection
