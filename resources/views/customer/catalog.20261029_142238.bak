    </form>

    <div class="rk-real-catalog-grid">
        @forelse($products as $product)
            <article class="rk-real-catalog-card">
                <div class="rk-real-catalog-image-wrap">
                    @if($product->image_path)
                        <img class="rk-real-catalog-image" src="{{ asset('storage/'.$product->image_path) }}" alt="Foto {{ $product->name }}" loading="lazy">
                    @else
                        <div class="rk-real-catalog-no-image"><span>RotiKita</span><small>Foto belum tersedia</small></div>
                    @endif
                    @if($product->stock_qty === 0)<span class="rk-real-product-tag rk-real-product-tag-muted">Habis</span>@elseif($product->stock_qty <= 5)<span class="rk-real-product-tag">Stok terbatas</span>@endif
                </div>
                <div class="rk-real-catalog-info">
                    <div class="rk-real-catalog-category">{{ $product->category }}</div>
                    <h3>{{ $product->name }}</h3>
                    <p>{{ $product->description ?: 'Produk pilihan RotiKita.' }}</p>
                    <div class="rk-real-catalog-bottom"><strong>Rp {{ number_format((float)$product->price, 0, ',', '.') }}</strong><span>{{ $product->stock_qty > 0 ? 'Stok '.$product->stock_qty : 'Stok habis' }}</span></div>
                </div>
            </article>
        @empty
            <div class="rk-real-empty rk-real-catalog-empty"><strong>Belum ada produk yang ditampilkan.</strong><p>Produk akan muncul setelah admin menambahkan produk aktif beserta harga dan stok. Ini bukan data contoh.</p></div>
